<?xml version="1.0" encoding="UTF-8"?>
<!-- SPCO sitemap stylesheet (20 Nov 2026), in the style of Yoast's classic sitemap view.
     Yoast SEO 28.9 stopped shipping its XSL stylesheet; browsers that still support XSLT use this one
     (clickable links); browsers without XSLT fall back to Yoast's /main-sitemap.css. Search engines ignore both. -->
<xsl:stylesheet version="1.0"
	xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
	xmlns:sitemap="http://www.sitemaps.org/schemas/sitemap/0.9"
	xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
	exclude-result-prefixes="sitemap image">
<xsl:output method="html" version="1.0" encoding="UTF-8" indent="yes"/>
<xsl:template name="date">
	<xsl:param name="d"/>
	<xsl:value-of select="concat(substring($d,1,10),' ',substring($d,12,5),' ',substring($d,20,6))"/>
</xsl:template>
<xsl:template match="/">
<html lang="en">
<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="robots" content="noindex, follow"/>
	<title>XML Sitemap</title>
	<style>
		body{font-family:Helvetica,Arial,sans-serif;font-size:13px;color:#545353;margin:0}
		#content{margin:0 auto;width:1000px;max-width:calc(100% - 32px)}
		h1{font-size:2em;margin:.67em 0 0;color:#545353}
		p.expl{margin:18px 3px;line-height:1.5}
		p.expl a{color:#da3114;font-weight:600;text-decoration:none}
		p.expl a:hover{text-decoration:underline}
		table{border:none;border-collapse:collapse;width:100%;font-size:11px}
		th{text-align:left;padding:5px 3px;border-bottom:1px solid #000;font-size:11px}
		td{padding:5px 3px}
		tbody tr:nth-child(odd) td{background-color:#eee}
		tbody tr:hover td{background-color:#ccc}
		tbody tr:hover td,tbody tr:hover td a{color:#000}
		a{color:#000;text-decoration:none;word-break:break-all}
		a:hover{text-decoration:underline}
		td.num,td.date{white-space:nowrap}
	</style>
</head>
<body>
<div id="content">
	<h1>XML Sitemap</h1>
	<p class="expl">Generated by <a href="https://yoast.com/wordpress/plugins/seo/" target="_blank" rel="noopener">Yoast SEO</a>, this is an XML Sitemap, meant for consumption by search engines.<br/>
	You can find more information about XML sitemaps on <a href="https://sitemaps.org" target="_blank" rel="noopener">sitemaps.org</a>.</p>
	<xsl:choose>
	<xsl:when test="count(sitemap:sitemapindex/sitemap:sitemap) &gt; 0">
		<p class="expl">This XML Sitemap Index file contains <xsl:value-of select="count(sitemap:sitemapindex/sitemap:sitemap)"/> sitemap<xsl:if test="count(sitemap:sitemapindex/sitemap:sitemap) != 1">s</xsl:if>.</p>
		<table>
			<thead><tr><th width="75%">Sitemap</th><th width="25%">Last Modified</th></tr></thead>
			<tbody>
			<xsl:for-each select="sitemap:sitemapindex/sitemap:sitemap">
				<tr>
					<td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
					<td class="date"><xsl:call-template name="date"><xsl:with-param name="d" select="sitemap:lastmod"/></xsl:call-template></td>
				</tr>
			</xsl:for-each>
			</tbody>
		</table>
	</xsl:when>
	<xsl:otherwise>
		<p class="expl"><a href="/sitemap_index.xml">&#8592; Sitemap Index</a></p>
		<p class="expl">This XML Sitemap contains <xsl:value-of select="count(sitemap:urlset/sitemap:url)"/> URL<xsl:if test="count(sitemap:urlset/sitemap:url) != 1">s</xsl:if>.</p>
		<table>
			<thead><tr><th width="80%">URL</th><th width="5%">Images</th><th width="15%">Last Mod.</th></tr></thead>
			<tbody>
			<xsl:for-each select="sitemap:urlset/sitemap:url">
				<tr>
					<td><a href="{sitemap:loc}"><xsl:value-of select="sitemap:loc"/></a></td>
					<td class="num"><xsl:value-of select="count(image:image)"/></td>
					<td class="date"><xsl:call-template name="date"><xsl:with-param name="d" select="sitemap:lastmod"/></xsl:call-template></td>
				</tr>
			</xsl:for-each>
			</tbody>
		</table>
	</xsl:otherwise>
	</xsl:choose>
</div>
</body>
</html>
</xsl:template>
</xsl:stylesheet>
